# Generated by Terraform (ansible.tf) on every apply; do not edit by hand
%{ for group in groups ~}

[${group}]
%{ for name, host in hosts ~}
%{ if host.group == group ~}
${name} ansible_host=${host.address}%{ if length(host.ssh_sources) > 0 } ssh_sources="[${join(", ", [for s in host.ssh_sources : "'${s}'"])}]"%{ endif }
%{ endif ~}
%{ endfor ~}
%{ endfor ~}

# Every VM in these groups only accepts SSH from the jump host
[via_jumphost:children]
%{ for group in jumphost_groups ~}
${group}
%{ endfor ~}

[via_jumphost:vars]
ansible_ssh_common_args='-o ProxyJump=${admin_username}@${jumphost_ip}'

[all:vars]
ansible_user=${admin_username}
ansible_python_interpreter=/usr/bin/python3
