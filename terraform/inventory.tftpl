# Generated by Terraform (ansible.tf) on every apply; do not edit by hand
# Ansible runs on vm-mgmt-01, which reaches every VM directly over the VNet
%{ for group in groups ~}

[${group}]
%{ for name, host in hosts ~}
%{ if host.group == group ~}
${name} ansible_host=${host.address}%{ if host.local } ansible_connection=local%{ endif }%{ if length(host.ssh_sources) > 0 } ssh_sources="[${join(", ", [for s in host.ssh_sources : "'${s}'"])}]"%{ endif }
%{ endif ~}
%{ endfor ~}
%{ endfor ~}

[all:vars]
ansible_user=${admin_username}
ansible_python_interpreter=/usr/bin/python3
