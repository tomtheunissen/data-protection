#cloud-config
# Bootstraps vm-mgmt-01 as the Ansible control node; rendered by Terraform (compute.tf)
package_update: true
packages:
  - git
  - ansible

write_files:
  # Same inventory Terraform writes to ansible/inventory.ini, so the first run does not depend on a git push
  - path: /var/lib/zkoo/inventory.ini
    permissions: "0644"
    content: |
      ${indent(6, inventory)}
  - path: /usr/local/sbin/zkoo-bootstrap.sh
    permissions: "0750"
    content: |
      #!/bin/bash
      # Fetches keys from Key Vault, clones the repo and runs the first Ansible play
      set -euo pipefail
      exec >>/var/log/zkoo-bootstrap.log 2>&1

      ADMIN_USER="${admin_username}"
      ADMIN_HOME="/home/$ADMIN_USER"
      KEY_VAULT="${key_vault_name}"
      REPO_URL="${repo_url}"
      REPO_DIR="$ADMIN_HOME/data-protection"
      VPN_IP="${vpn_ip}"

      echo "Installing Azure CLI"
      curl -sL https://aka.ms/InstallAzureCLIDeb | bash

      echo "Logging in with the managed identity"
      until az login --identity --allow-no-subscriptions --output none; do
        sleep 15
      done

      # The Key Vault and its access policy are created after this VM, so retry until the secret is readable
      fetch_secret() {
        until az keyvault secret show --vault-name "$KEY_VAULT" --name "$1" --query value --output tsv >"$2" && [ -s "$2" ]; do
          echo "Waiting for secret $1"
          sleep 20
        done
      }

      install -d -m 700 -o "$ADMIN_USER" -g "$ADMIN_USER" "$ADMIN_HOME/.ssh"
      fetch_secret github-deploy-key "$ADMIN_HOME/.ssh/github_deploy"
      fetch_secret mgmt-ssh-key "$ADMIN_HOME/.ssh/id_ed25519"

      ssh-keyscan -t ed25519 github.com >>"$ADMIN_HOME/.ssh/known_hosts"
      cat >"$ADMIN_HOME/.ssh/config" <<SSHCONFIG
      Host github.com
        IdentityFile ~/.ssh/github_deploy
        IdentitiesOnly yes
      SSHCONFIG
      chmod 600 "$ADMIN_HOME/.ssh/"*
      chown -R "$ADMIN_USER:$ADMIN_USER" "$ADMIN_HOME/.ssh"

      echo "Cloning the repository"
      if [ ! -d "$REPO_DIR/.git" ]; then
        sudo -H -u "$ADMIN_USER" git clone "$REPO_URL" "$REPO_DIR"
      fi

      echo "Waiting until vm-vpn-01 accepts SSH"
      until sudo -H -u "$ADMIN_USER" ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 "$ADMIN_USER@$VPN_IP" true; do
        sleep 20
      done

      echo "Running Ansible for the VPN server and the jump host"
      cd "$REPO_DIR/ansible"
      install -m 644 -o "$ADMIN_USER" -g "$ADMIN_USER" /var/lib/zkoo/inventory.ini inventory.ini
      sudo -H -u "$ADMIN_USER" ansible-galaxy collection install -r requirements.yml
      sudo -H -u "$ADMIN_USER" ansible-playbook -i inventory.ini playbook.yml --limit vpn,mgmt
      echo "Bootstrap finished"

runcmd:
  - [/usr/local/sbin/zkoo-bootstrap.sh]
