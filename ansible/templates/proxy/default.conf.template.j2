# Managed by Ansible
# Replaces the image's default.conf.template so requests can be routed per path.
# The image still renders ${...} variables and the *_CONFIG placeholders at start-up.
# ModSecurity is enabled for all servers in conf.d/modsecurity.conf (from the image).

# Hide the software behind the proxy: no version on error pages, no Server or X-Powered-By header
server_tokens off;
more_clear_headers Server X-Powered-By;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Plain HTTP is not published on the host; it only serves the image's health check
server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    location / {
        return 301 https://$host$request_uri;
    }

    include includes/location_common.conf;
}

server {
    listen ${SSL_PORT} ssl;
    HTTP3_CONFIG

    server_name ${SERVER_NAME};

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;

    ssl_dhparam /etc/ssl/certs/dhparam-${SSL_DH_BITS}.pem;

    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_prefer_server_ciphers ${SSL_PREFER_CIPHERS};

    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    PROXY_SSL_CONFIG

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Patient portal (vm-web-01); the prefix is stripped before forwarding
    location = {{ proxy_portal_path | regex_replace('/$', '') }} {
        return 301 {{ proxy_portal_path }};
    }

    location {{ proxy_portal_path }} {
        client_max_body_size 10m;
        proxy_pass https://portal_backend/;
        # The prefix is stripped, so root-relative redirects from the portal (Location: /x) must get it back.
        # absolute_redirect off keeps them relative; otherwise nginx adds scheme, host and the container port 8443
        proxy_redirect / {{ proxy_portal_path }};
        absolute_redirect off;
    }

    {% if proxy_media_enabled %}
    # Training videos (vm-media-01); the prefix is kept because Jellyfin's Base URL is /media
    location = {{ proxy_media_path | regex_replace('/$', '') }} {
        return 301 {{ proxy_media_path }};
    }

    location {{ proxy_media_path }} {
        client_max_body_size 1m;
        proxy_pass http://media_backend;

        # Any proxy_set_header here stops inheritance from the server block, so repeat them all
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Websockets for Jellyfin's live updates
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Stream video straight through instead of buffering it on the proxy
        proxy_buffering off;
    }
    {% endif %}

    {% if proxy_webapp_enabled %}
    # WebAPP02 (app-zkoo-02) through its private endpoint; public access to the app is disabled
    location = {{ proxy_webapp_path | regex_replace('/$', '') }} {
        return 301 {{ proxy_webapp_path }};
    }

    location {{ proxy_webapp_path }} {
        client_max_body_size 1m;
        # The endpoint IP avoids a DNS lookup at start-up; SNI and Host carry the app name
        proxy_pass https://{{ proxy_webapp_ip }}/;
        proxy_ssl_server_name on;
        proxy_ssl_name {{ proxy_webapp_host }};

        # Any proxy_set_header here stops inheritance from the server block, so repeat them all
        proxy_set_header Host {{ proxy_webapp_host }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Redirects from the app use its own host name or a root path; keep users under the prefix
        proxy_redirect https://{{ proxy_webapp_host }}/ {{ proxy_webapp_path }};
        proxy_redirect / {{ proxy_webapp_path }};
        absolute_redirect off;
    }
    {% endif %}

    # Public company website (vm-web-02)
    location / {
        client_max_body_size 1m;
        proxy_pass https://site_backend;
    }

    include includes/location_common.conf;
}

