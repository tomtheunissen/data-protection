# Managed by Ansible
user nginx;
worker_processes auto;

events {
    worker_connections 1024;
}

stream {
    upstream sftp_backend {
        server {{ hostvars[groups['sftp'][0]].ansible_host }}:{{ proxy_sftp_backend_port }};
    }

    server {
        listen 2222;
        proxy_pass sftp_backend;
        proxy_connect_timeout 10s;
        proxy_timeout 30m;
    }
}
