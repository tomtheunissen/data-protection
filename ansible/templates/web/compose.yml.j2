# Managed by Ansible, changes are overwritten
name: web

services:
  site:
    image: {{ web_image }}
    restart: unless-stopped
    ports:
      - "443:443"
    volumes:
      - ./default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./html:/usr/share/nginx/html:ro
      - ./certs:/etc/nginx/certs:ro
{% if web_role == 'portal' and web_dvwa_enabled | default(false) %}
    # nginx resolves "dvwa" at start-up, so DVWA must be running first
    depends_on:
      - dvwa

  # Deliberately vulnerable test target for the SQLi/XSS scenarios; holds no patient data
  dvwa:
    image: {{ dvwa_image }}
    restart: unless-stopped
    environment:
      DB_SERVER: dvwa-db
      DB_DATABASE: dvwa
      DB_USER: dvwa
      DB_PASSWORD: "{{ dvwa_db_password }}"
      DEFAULT_SECURITY_LEVEL: low
    depends_on:
      - dvwa-db

  dvwa-db:
    image: {{ dvwa_db_image }}
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ dvwa_db_password }}"
      MYSQL_DATABASE: dvwa
      MYSQL_USER: dvwa
      MYSQL_PASSWORD: "{{ dvwa_db_password }}"
    volumes:
      - dvwa-db:/var/lib/mysql

volumes:
  dvwa-db:
{% endif %}