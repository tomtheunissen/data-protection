# Managed by Ansible, changes are overwritten
name: web

services:
  site:
    image: {{ web_image }}
    restart: unless-stopped
    ports:
      - "443:443"
    volumes:
      - ./default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./html:/usr/share/nginx/html:ro
      - ./certs:/etc/nginx/certs:ro
