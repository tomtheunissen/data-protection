# Managed by Ansible
server {
    listen 443 ssl;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
{% if web_role == 'portal' and web_dvwa_enabled | default(false) %}

    # Vulnerable test target; only reachable through the reverse proxy and its WAF
    location /dvwa/ {
        proxy_pass http://dvwa:80/;
        # DVWA redirects to $_SERVER['PHP_SELF'] (Location: /setup.php); put the /dvwa/ prefix back
        proxy_redirect / /dvwa/;
        # Keep the rewritten redirect relative, so the reverse proxy can add its own /portaal/ prefix
        absolute_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
{% endif %}
}